# ─────────────────────────────────────────────────────────────
#  AI Subtitle Studio – Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Server
HOST=127.0.0.1
PORT=8000

# OpenAI – get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Upload limits
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.avi,.webm

# Storage paths (absolute or relative to project root)
UPLOAD_DIR=storage/uploads
TEMP_DIR=storage/temporary
OUTPUT_DIR=storage/outputs

# Job cleanup – files older than this (hours) are deleted automatically
CLEANUP_AFTER_HOURS=24

# CORS origins (comma-separated) – use * for local dev, restrict in production
CORS_ORIGINS=*
